terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = var.aws_region
}

variable "aws_region" {
  default = "us-east-1"
}

variable "project_name" {
  default = "password-validator-300326"
}

# Bucket que vai guardar todos os terraform.tfstate do projeto
resource "aws_s3_bucket" "terraform_state" {
  bucket = "${var.project_name}-tfstate"

  # Impede que o bucket seja deletado acidentalmente com terraform destroy
  lifecycle {
    prevent_destroy = true
  }
}

# Versionamento: permite recuperar um state anterior em caso de corrupção
resource "aws_s3_bucket_versioning" "terraform_state" {
  bucket = aws_s3_bucket.terraform_state.id
  versioning_configuration {
    status = "Enabled"
  }
}

# Criptografia: state pode conter secrets (senhas, tokens)
resource "aws_s3_bucket_server_side_encryption_configuration" "terraform_state" {
  bucket = aws_s3_bucket.terraform_state.id
  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm = "AES256"
    }
  }
}

# Bloqueia acesso público: state nunca deve ser público
resource "aws_s3_bucket_public_access_block" "terraform_state" {
  bucket                  = aws_s3_bucket.terraform_state.id
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

# DynamoDB: garante que só um terraform apply rode por vez (lock)
# Sem isso, dois pipelines simultâneos podem corromper o state
resource "aws_dynamodb_table" "terraform_lock" {
  name         = "${var.project_name}-tflock"
  billing_mode = "PAY_PER_REQUEST"
  hash_key     = "LockID"

  attribute {
    name = "LockID"
    type = "S"
  }
}

output "state_bucket_name" {
  value = aws_s3_bucket.terraform_state.bucket
}

output "lock_table_name" {
  value = aws_dynamodb_table.terraform_lock.name
}
